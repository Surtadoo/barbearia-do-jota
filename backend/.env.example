PORT=3001

# ==========================================================
#  MODO DE PAGAMENTO
# ==========================================================
#  link_unico  = cada agendamento ganha uma cobranca nova.
#                Varios clientes podem pagar ao mesmo tempo.
#                ESTE E O MODO RECOMENDADO.
#
#  link_fixo   = todo mundo paga no mesmo link (INFINITEPAY_LINK).
#                So use se quiser um link so. Nesse caso o sistema
#                so confirma quem pagou DEPOIS do link estar marcado
#                como pago, para nao liberar corte de graca.
# ==========================================================
MODO_PAGAMENTO=link_unico

# Chave da API da InfinitePay (Painel > Desenvolvedor > API Keys).
# NUNCA colocar no site - somente neste servidor.
INFINITYPAY_API_KEY=inchk_r8sDyR4Cz9wHulzOert5pcjrny9ARfACvfC0TGVI50c

# Seu Infinite Tag / Handle da InfinitePay
INFINITEPAY_HANDLE=yago-assumpcao-y9d

# Usado so no modo link_fixo. Link unico nao precisa.
INFINITEPAY_LINK=https://link.infinitepay.io/yago-assumpcao-y9d/VC1B-ZROqZmZFD4-10,00
INFINITEPAY_LINK_SLUG=VC1B-ZROqZmZFD4-10,00

# Valor do sinal em reais (descontado do total no local)
SIGNAL_VALUE=10

# URL publica do backend (para o webhook). Ex: https://barbearia.onrender.com
# Deixe vazio no teste local - o site consulta o status sozinho mesmo sem webhook.
PUBLIC_BASE_URL=
